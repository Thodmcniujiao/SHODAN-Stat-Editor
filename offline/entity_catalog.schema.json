{
  "title": "SHODAN entity group JSON",
  "type": "object",
  "required": [
    "entities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "group": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          },
          "minProperties": 1
        }
      ]
    },
    "name": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          },
          "minProperties": 1
        }
      ]
    },
    "order": {
      "type": "number"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hash",
          "name"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^(0[xX][0-9A-Fa-f]{1,16}|[0-9]{1,20}|[0-9A-Fa-f]{16})$"
          },
          "name": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 1024
                },
                "minProperties": 1
              }
            ]
          },
          "kind": {
            "enum": [
              "entity",
              "unit"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
